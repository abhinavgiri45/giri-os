#!/bin/sh
# ====================================================================
# Giri Space — Official X11 Desktop Session Entrypoint
# Author: Abhinav Giri / Giri OS Core Engineering Team
# License: GPL-3.0-or-later
#
# Orchestrates window manager (Openbox), compositor (Picom),
# notification daemon (Dunst), and Giri Space desktop shell.
# Automatically adapts to Intel HD 2000, VirtualBox, and Modern GPUs.
# ====================================================================

PROFILE="classic"
if [ "$1" = "--profile" ] && [ -n "$2" ]; then
    PROFILE="$2"
else
    # Automatically query universal graphics detector
    if command -v giri-hw >/dev/null 2>&1; then
        GFX_PROF=$(giri-hw --graphics-profile 2>/dev/null || true)
        if [ -n "$GFX_PROF" ]; then
            PROFILE="$GFX_PROF"
        fi
    elif [ -f /usr/lib/giri/hardware/giri-hw/detector.py ]; then
        GFX_PROF=$(python3 /usr/lib/giri/hardware/giri-hw/detector.py --graphics-profile 2>/dev/null || true)
        if [ -n "$GFX_PROF" ]; then
            PROFILE="$GFX_PROF"
        fi
    fi
fi

# 0. Ensure Plymouth boot screen releases the display buffer
if command -v plymouth >/dev/null 2>&1; then
    plymouth --quit || true
fi

# 1. Start X11 Window Manager (Openbox) in background to manage window frames
if command -v openbox >/dev/null 2>&1; then
    openbox --sm-disable &
fi

# 2. Start Compositor dynamically based on detected graphics capabilities
# - modern: Full GLX backend with VSync
# - intel_legacy: Lightweight XRender backend (avoids GLX overhead on Intel HD 2000)
# - virtualbox / software_rendering / recovery / classic: Disabled to prevent dropped 3D commands
case "$PROFILE" in
    modern)
        if command -v picom >/dev/null 2>&1; then
            picom -b --backend glx --vsync &
        fi
        ;;
    intel_legacy)
        if command -v picom >/dev/null 2>&1; then
            picom -b --backend xrender &
        fi
        ;;
    *)
        # Compositor disabled for VirtualBox and software rendering
        ;;
esac

# 3. Start Notification Daemon
if command -v dunst >/dev/null 2>&1; then
    dunst &
fi

# 4. Set Default Background via feh if available
if command -v feh >/dev/null 2>&1; then
    if [ -f /usr/share/backgrounds/giri-origin.png ]; then
        feh --bg-fill /usr/share/backgrounds/giri-origin.png &
    fi
fi

# 4b. Giri Welcome & First Boot Experience
# Only runs on a freshly installed system when first-boot completion flag is absent.
# Live ISO sessions and subsequent boots automatically bypass this.
# Guaranteed safe fallback: '|| true' ensures Giri Space launches even if firstboot exits.
if [ ! -d /run/live ] && [ ! -f /var/lib/giri/first-boot-done ] && [ ! -f "$HOME/.config/giri/first-boot-done" ]; then
    if [ -f /usr/lib/giri/first-boot/giri_welcome.py ]; then
        python3 /usr/lib/giri/first-boot/giri_welcome.py || true
    elif [ -f /usr/lib/giri/first-boot/first_boot_wizard.py ]; then
        python3 /usr/lib/giri/first-boot/first_boot_wizard.py || true
    fi
fi

# 5. Launch Giri Space Desktop Shell with Fail-Safe Crash Recovery
# Map graphics profile to desktop shell tier ('modern' or 'classic')
SHELL_TIER="classic"
if [ "$PROFILE" = "modern" ]; then
    SHELL_TIER="modern"
fi

# Ensure diagnostic log directory exists
LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/giri/logs"
mkdir -p "$LOG_DIR"
SESSION_LOG="$LOG_DIR/session.log"
echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] Giri Space session starting (profile: $PROFILE, tier: $SHELL_TIER)..." >> "$SESSION_LOG"

# Locate shell script
SHELL_SCRIPT=""
if [ -f /usr/share/giri-space/shell/giri_space.py ]; then
    SHELL_SCRIPT="/usr/share/giri-space/shell/giri_space.py"
elif [ -f "$(dirname "$0")/../shell/giri_space.py" ]; then
    SHELL_SCRIPT="$(dirname "$0")/../shell/giri_space.py"
fi

# Locate recovery dialog script
RECOVERY_SCRIPT=""
if [ -f /usr/share/giri-space/session/giri_recovery.py ]; then
    RECOVERY_SCRIPT="/usr/share/giri-space/session/giri_recovery.py"
elif [ -f "$(dirname "$0")/giri_recovery.py" ]; then
    RECOVERY_SCRIPT="$(dirname "$0")/giri_recovery.py"
fi

if [ -n "$SHELL_SCRIPT" ]; then
    # Launch desktop shell and capture execution
    START_TIME=$(date +%s)
    python3 "$SHELL_SCRIPT" --profile "$SHELL_TIER" 2>&1 | tee -a "$SESSION_LOG"
    SHELL_EXIT=$?
    END_TIME=$(date +%s)
    RUNTIME=$((END_TIME - START_TIME))

    # If exit code is 0, user intentionally exited/logged out
    if [ "$SHELL_EXIT" -eq 0 ]; then
        echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] Giri Space session exited cleanly." >> "$SESSION_LOG"
        exit 0
    fi

    # Unhandled failure detected: Enter Fail-Safe Recovery Mode
    echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] WARNING: Giri Space crashed (exit code: $SHELL_EXIT, runtime: ${RUNTIME}s)." >> "$SESSION_LOG"

    # Ensure window manager is running so user has window controls
    if ! pidof openbox >/dev/null 2>&1; then
        openbox --sm-disable &
    fi

    # Set background color to prevent black screen
    if command -v xsetroot >/dev/null 2>&1; then
        xsetroot -solid "#0a0e1a" || true
    fi

    # If recovery script is available, run recovery dialog
    if [ -n "$RECOVERY_SCRIPT" ]; then
        python3 "$RECOVERY_SCRIPT" "$SESSION_LOG"
        RECOVERY_EXIT=$?
        # Exit code 42 indicates user requested Safe Graphics retry
        if [ "$RECOVERY_EXIT" -eq 42 ]; then
            echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] User requested Safe Graphics retry." >> "$SESSION_LOG"
            exec python3 "$SHELL_SCRIPT" --profile classic 2>&1 | tee -a "$SESSION_LOG"
        fi
    fi

    # Fail-safe terminal access to ensure user is NEVER locked out
    echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] Opening fail-safe rescue terminal..." >> "$SESSION_LOG"
    for term in kitty xterm xfce4-terminal; do
        if command -v "$term" >/dev/null 2>&1; then
            exec "$term"
        fi
    done
else
    echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] CRITICAL: giri_space.py not found! Starting emergency terminal..." >> "$SESSION_LOG"
    for term in kitty xterm xfce4-terminal; do
        if command -v "$term" >/dev/null 2>&1; then
            exec "$term"
        fi
    done
fi

#!/bin/sh
# ====================================================================
# Giri Space — Official X11 Desktop Session Entrypoint
# Author: Abhinav Giri / Giri OS Core Engineering Team
# License: GPL-3.0-or-later
#
# Orchestrates window manager (Openbox), compositor (Picom),
# notification daemon (Dunst), and Giri Space desktop shell.
# Automatically adapts to Intel HD 2000, VirtualBox, and Modern GPUs.
# ====================================================================

PROFILE="classic"
if [ "$1" = "--profile" ] && [ -n "$2" ]; then
    PROFILE="$2"
else
    # Automatically query universal graphics detector
    if command -v giri-hw >/dev/null 2>&1; then
        GFX_PROF=$(giri-hw --graphics-profile 2>/dev/null || true)
        if [ -n "$GFX_PROF" ]; then
            PROFILE="$GFX_PROF"
        fi
    elif [ -f /usr/lib/giri/hardware/giri-hw/detector.py ]; then
        GFX_PROF=$(python3 /usr/lib/giri/hardware/giri-hw/detector.py --graphics-profile 2>/dev/null || true)
        if [ -n "$GFX_PROF" ]; then
            PROFILE="$GFX_PROF"
        fi
    fi
fi

# 0. Ensure Plymouth boot screen releases the display buffer
if command -v plymouth >/dev/null 2>&1; then
    plymouth --quit || true
fi

# 1. Start X11 Window Manager (Openbox) in background to manage window frames
if command -v openbox >/dev/null 2>&1; then
    openbox --sm-disable &
fi

# 2. Start Compositor dynamically based on detected graphics capabilities
# - modern: Full GLX backend with VSync
# - intel_legacy: Lightweight XRender backend (avoids GLX overhead on Intel HD 2000)
# - virtualbox / software_rendering / recovery / classic: Disabled to prevent dropped 3D commands
case "$PROFILE" in
    modern)
        if command -v picom >/dev/null 2>&1; then
            picom -b --backend glx --vsync &
        fi
        ;;
    intel_legacy)
        if command -v picom >/dev/null 2>&1; then
            picom -b --backend xrender &
        fi
        ;;
    *)
        # Compositor disabled for VirtualBox and software rendering
        ;;
esac

# 3. Start Notification Daemon
if command -v dunst >/dev/null 2>&1; then
    dunst &
fi

# 4. Set Default Background via feh if available
if command -v feh >/dev/null 2>&1; then
    if [ -f /usr/share/backgrounds/giri-origin.png ]; then
        feh --bg-fill /usr/share/backgrounds/giri-origin.png &
    fi
fi

# 4b. Giri Welcome & First Boot Experience
# Only runs on a freshly installed system when first-boot completion flag is absent.
# Live ISO sessions and subsequent boots automatically bypass this.
# Guaranteed safe fallback: '|| true' ensures Giri Space launches even if firstboot exits.
if [ ! -d /run/live ] && [ ! -f /var/lib/giri/first-boot-done ] && [ ! -f "$HOME/.config/giri/first-boot-done" ]; then
    if [ -f /usr/lib/giri/first-boot/giri_welcome.py ]; then
        python3 /usr/lib/giri/first-boot/giri_welcome.py || true
    elif [ -f /usr/lib/giri/first-boot/first_boot_wizard.py ]; then
        python3 /usr/lib/giri/first-boot/first_boot_wizard.py || true
    fi
fi

# 5. Launch Giri Space Desktop Shell as main session process
# Map graphics profile to desktop shell tier ('modern' or 'classic')
SHELL_TIER="classic"
if [ "$PROFILE" = "modern" ]; then
    SHELL_TIER="modern"
fi

if [ -f /usr/share/giri-space/shell/giri_space.py ]; then
    exec python3 /usr/share/giri-space/shell/giri_space.py --profile "$SHELL_TIER"
elif [ -f "$(dirname "$0")/../shell/giri_space.py" ]; then
    exec python3 "$(dirname "$0")/../shell/giri_space.py" --profile "$SHELL_TIER"
else
    exec xterm
fi

#!/bin/sh
set -e

# ====================================================================
# GIRI OS 0.1 "Genesis" — Live-Build Auto Configuration Script
# Target: Debian 12 (Bookworm) amd64 Hybrid Live/Installer ISO
# Founder: Abhinav Giri | Tagline: One System. Infinite Possibilities.
# ====================================================================

export DEBOOTSTRAP_OPTIONS="${DEBOOTSTRAP_OPTIONS:---keyring=/usr/share/keyrings/debian-archive-keyring.gpg}"

lb config noauto \
    --mode debian \
    --distribution bookworm \
    --architectures amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --bootloader syslinux \
    --bootappend-live "boot=live components quiet splash username=giri hostname=giri-os" \
    --linux-flavours amd64 \
    --memtest memtest86+ \
    --iso-application "Giri OS 0.1 Genesis" \
    --iso-preparer "Abhinav Giri <lead@girios.org>" \
    --iso-publisher "Giri OS Open Source Project; https://girios.org" \
    --iso-volume "GIRI_OS_01_GENESIS" \
    --mirror-bootstrap "http://deb.debian.org/debian/" \
    --mirror-chroot "http://deb.debian.org/debian/" \
    --mirror-binary "http://deb.debian.org/debian/" \
    --parent-mirror-bootstrap "http://deb.debian.org/debian/" \
    --parent-mirror-chroot "http://deb.debian.org/debian/" \
    --parent-mirror-binary "http://deb.debian.org/debian/" \
    --keyring-packages debian-archive-keyring \
    --apt-indices false \
    --apt-recommends true \
    --security false \
    --win32-loader false \
    "${@}"

#!/bin/sh
set -e

# ====================================================================
# GIRI OS 0.1 "Genesis" — Live Chroot Configuration Hook
# Executed inside the live environment before squashfs creation
# Founder: Abhinav Giri | Tagline: One System. Infinite Possibilities.
# ====================================================================

echo ">>> [Giri OS] Configuring System Branding & Live User Environment..."

# 0. Configure Official Production APT Sources for Bookworm
cat << 'EOF' > /etc/apt/sources.list
deb http://deb.debian.org/debian bookworm main contrib non-free non-free-firmware
deb http://deb.debian.org/debian bookworm-updates main contrib non-free non-free-firmware
deb http://security.debian.org/debian-security bookworm-security main contrib non-free non-free-firmware
EOF

# 1. Enable 32-bit Multiarch for Wine Application Compatibility
dpkg --add-architecture i386 || true

# 2. Hostname Setup
echo "giri-os" > /etc/hostname

# 3. Configure Plymouth Boot Splash Theme
if [ -d /usr/share/plymouth/themes/giri-genesis ]; then
    echo ">>> Setting Plymouth default theme to giri-genesis..."
    plymouth-set-default-theme -R giri-genesis || true
fi

# 4. Configure Default Live User Privileges (giri & autologin)
groupadd -f -r autologin
if id "giri" >/dev/null 2>&1; then
    echo "User giri already exists."
    usermod -aG autologin,sudo,audio,video,plugdev,netdev,games,cdrom giri || true
else
    useradd -m -s /bin/bash -g users -G autologin,sudo,audio,video,plugdev,netdev,games,cdrom giri || true
    echo "giri:giri" | chpasswd
fi

# Ensure autologin group exists and live fallback user is also added if present
if id "user" >/dev/null 2>&1; then
    usermod -aG autologin,sudo,audio,video,plugdev,netdev,games,cdrom user || true
fi

# Grant passwordless sudo for live session
echo "giri ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/giri-live
echo "user ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers.d/giri-live
chmod 0440 /etc/sudoers.d/giri-live

# 5. Configure LightDM Greeter & Default Session
mkdir -p /etc/lightdm/lightdm.conf.d/
cat << 'EOF' > /etc/lightdm/lightdm.conf.d/01-giri-defaults.conf
[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=giri-space-classic
autologin-user=giri
autologin-user-timeout=0
display-setup-script=/usr/bin/giri-display-setup
EOF

# Create display setup script to ensure Plymouth releases display buffer cleanly
cat << 'EOF' > /usr/bin/giri-display-setup
#!/bin/sh
if command -v plymouth >/dev/null 2>&1; then
    plymouth --quit || true
fi
if command -v xrandr >/dev/null 2>&1; then
    xrandr --auto || true
fi
exit 0
EOF
chmod +x /usr/bin/giri-display-setup

# 6. Ensure Giri Space Desktop & Session Executables are Linked
if [ -f /usr/share/giri-space/shell/giri_space.py ]; then
    chmod +x /usr/share/giri-space/shell/giri_space.py
    ln -sf /usr/share/giri-space/shell/giri_space.py /usr/bin/giri-space
fi

if [ -f /usr/share/giri-space/session/giri-session ]; then
    chmod +x /usr/share/giri-space/session/giri-session
    ln -sf /usr/share/giri-space/session/giri-session /usr/bin/giri-session
fi

# 7. Symlink All Giri Core Utilities to /usr/bin/
if [ -f /usr/share/giri-space/control-center/control_center.py ]; then
    chmod +x /usr/share/giri-space/control-center/control_center.py
    ln -sf /usr/share/giri-space/control-center/control_center.py /usr/bin/giri-control
fi

if [ -f /usr/lib/giri/hardware/giri-hw/detector.py ]; then
    chmod +x /usr/lib/giri/hardware/giri-hw/detector.py
    ln -sf /usr/lib/giri/hardware/giri-hw/detector.py /usr/bin/giri-hw
fi

if [ -f /usr/lib/giri/compatibility/giri-bridge/runner.py ]; then
    chmod +x /usr/lib/giri/compatibility/giri-bridge/runner.py
    ln -sf /usr/lib/giri/compatibility/giri-bridge/runner.py /usr/bin/giri-bridge
fi

if [ -f /usr/lib/giri/gaming/giri-gaming/governor.py ]; then
    chmod +x /usr/lib/giri/gaming/giri-gaming/governor.py
    ln -sf /usr/lib/giri/gaming/giri-gaming/governor.py /usr/bin/giri-game
fi

if [ -f /usr/lib/giri/updater/giri-update/client.py ]; then
    chmod +x /usr/lib/giri/updater/giri-update/client.py
    ln -sf /usr/lib/giri/updater/giri-update/client.py /usr/bin/giri-update
fi

if [ -f /usr/lib/giri/first-boot/first_boot_wizard.py ]; then
    chmod +x /usr/lib/giri/first-boot/first_boot_wizard.py
    ln -sf /usr/lib/giri/first-boot/first_boot_wizard.py /usr/bin/giri-firstboot
fi

# 8. Setup Desktop Entries & Live User Desktop Icons
mkdir -p /usr/share/xsessions/

cat << 'EOF' > /usr/share/xsessions/giri-space-classic.desktop
[Desktop Entry]
Name=Giri Space (Classic)
Comment=Lightweight Giri OS Desktop Environment optimized for Intel HD 2000 and legacy hardware
Exec=/usr/bin/giri-session --profile classic
TryExec=/usr/bin/giri-session
Icon=giri-os-icon
Type=Application
DesktopNames=GiriSpace:Classic
Keywords=giri;desktop;space;classic;legacy;
EOF
chmod 0644 /usr/share/xsessions/giri-space-classic.desktop

cat << 'EOF' > /usr/share/xsessions/giri-space-modern.desktop
[Desktop Entry]
Name=Giri Space (Modern)
Comment=Modern Giri OS Desktop Environment with hardware acceleration and fluid visual effects
Exec=/usr/bin/giri-session --profile modern
TryExec=/usr/bin/giri-session
Icon=giri-os-icon
Type=Application
DesktopNames=GiriSpace:Modern
Keywords=giri;desktop;space;modern;
EOF
chmod 0644 /usr/share/xsessions/giri-space-modern.desktop

ln -sf /usr/share/xsessions/giri-space-classic.desktop /usr/share/xsessions/default.desktop

mkdir -p /home/giri/Desktop
if [ -d /etc/skel/Desktop ]; then
    cp -rf /etc/skel/Desktop/* /home/giri/Desktop/ || true
fi
chown -R giri:users /home/giri/Desktop || true

# 9. Ensure Bootloader Compatibility Symlinks & Directories
mkdir -p /usr/lib/ISOLINUX /usr/lib/syslinux/modules/bios
if [ -d /usr/lib/syslinux/modules/bios ]; then
    for mod in /usr/lib/syslinux/modules/bios/*; do
        if [ -f "$mod" ]; then
            ln -sf "$mod" /usr/lib/syslinux/$(basename "$mod") 2>/dev/null || true
        fi
    done
fi
if [ -f /usr/lib/ISOLINUX/isolinux.bin ]; then
    ln -sf /usr/lib/ISOLINUX/isolinux.bin /usr/lib/syslinux/isolinux.bin 2>/dev/null || true
fi

echo ">>> [Giri OS] Chroot configuration completed successfully."
